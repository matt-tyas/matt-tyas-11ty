@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@200;300;600&display=swap');

html {
    font-size: 1rem;
	font-size: clamp(1rem, 0.95rem + 0.25vw, 1.25rem);
}

body {
    font-family: 'Poppins', sans-serif;
    margin: 0 5%;
    background-color: var(--color-grey-warm-light);
}

.mt-main {
    padding-top: 0;
    padding-bottom: 0;
}

@media (--mq-large) {
    .mt-main {
        padding-top: 0;
    }
}

@media (--mq-large) {
    .mt-header {
      justify-content: space-between;
      flex-direction: row;
      margin-bottom: var(--spacing-32);
    }
}

.mt-header {
    display: flex;
    justify-content: space-between;
    flex-direction: column;
    position: relative;
    min-height: 100px;
    z-index: 2;
    margin: var(--spacing-16) 1%;
}
  
@media (--mq-medium) {
    .mt-header {
      justify-content: space-between;
      flex-direction: row;
      margin-bottom: var(--spacing-32);
    }
}

.mt-logo {
    display: flex;
    align-items: center; 
    height: 100px;
}

.mt-computer {
    margin-right: 1rem;
}

.mt-logo:hover .mt-expression--is-happy {
    display: block;
}

.mt-logo:hover .mt-computer {
    position: relative;
    animation: wiggle .75s ease;
}

@keyframes wiggle {
   0% { transform: rotate(5deg); }
   50% { transform: rotate(-5deg); }
  100% { transform: rotate(0deg); }
}

.mt-logo:hover .mt-expression {
    display: none;
}

.mt-expression--is-happy {
    display: none;
    animation: none;
}

.mt-section {
    margin: 4rem 0 0 0;
}

@media (--mq-large) {
    .mt-section {
        margin: 4rem 0 0 0;
    }
}

.mt-stacking {
    z-index: 3;
    background-color: var(--color-grey-warm-light);
}

@media (--mq-medium) {
    .mt-stacking {
        background-color: transparent;
    }
}

.mt-me {
    width: 460px;
}

.mt-portrait {
    height: 220px;
    overflow: hidden;
}

.mt-portrait .mt-me {
    position: relative;
    top: 110px;
}

@media (--mq-medium) {
    .mt-portrait .mt-me{
        top: 0;
    }
}

@media (--mq-medium) {
    .mt-portrait {
        position: relative;
        left: -3rem;
        height: auto;
        overflow: hidden;
    }
}

.mt-icon {
    float: left;
    margin-bottom: 2rem;
    position: sticky;
    top: 1rem;
    align-self: flex-start;
}

@media (--mq-large) {
    .mt-icon {
        float: right;
    }
}

.mt-nav {
    margin-top: 0; 
    padding: 0.5rem 0 0 0;
}

@media (--mq-medium) {
    .mt-nav {
      margin-top: 8px; 
      margin-bottom: var(--spacing-32);
      padding: 1.5rem 0 0 0;
    }
}

.mt-nav__item {
    margin-right: .35rem;
}

@media (--mq-large) {
    .mt-nav__item  {
        margin-right: 1rem;
    }
}

.mt-nav__item:hover {
    text-decoration: none;
}

.mt-section--bg {
    position: relative;
    z-index: 2;
    margin: 0;
}

@media (--mq-large) {
    .mt-section--bg  {
        margin: 4rem 0 0 0;
    }
}

.mt-section--bg:after {
    background-image: url('/images/walls.svg');
    z-index: -1; 
    content: "";
    background-repeat: no-repeat;
    background-position: -20% 5%;
    position: absolute;
    top: 0px;
    right: 0px;
    bottom: 0px;
    left: 0px;
    opacity: 0.15;
   
}

@media (--mq-medium) {
    .mt-section--bg:after {   
        z-index: -1; 
        content: "";
        background-image: url('/images/walls-1.svg');
        background-repeat: no-repeat;
        background-position: 20% 30%;
        position: absolute;
        top: 0px;
        right: 0px;
        bottom: 0px;
        left: 0px;
        opacity: 0.15;
        
    }
}

.mt-section--content:after {
    background-size: 100%;
    background-position: 0% 0%;
}

@media (--mq-medium) {
    .mt-section--content:after {
        background-position: 10% 0%;
        background-size: 250px;
        min-height: 800px; 
    }
}

.mt-case-study:after {
    background-image: none;
}

.mt-case-study {
    position: relative;
    overflow: visible;
}

@media (--mq-medium) {
    .mt-case-study:after {
        display: block;
        background-image: url('/images/walls-2.svg'); 
        z-index: -1; 
        content: "";
        background-size: 300px;
        background-repeat: repeat-y;
        background-position: 0% 40%;
        position: absolute;
        top: 0px;
        right: 0px;
        bottom: 0px;
        left: 0px;
        opacity: 0.15;
        -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 90px, #000 calc(100% - 90px), transparent 100%);
        mask-image: linear-gradient(to bottom, transparent 0, #000 90px, #000 calc(100% - 90px), transparent 100%);
    }
}



.coop-l-grid__item {
    position: relative;
}

.mt-section--last {
   padding-bottom: 20rem;
}

.mt-text {
    max-width: 800px;
}

h1,
.mt-h1 {
    margin: 0;
    font-size: 1.4rem;
    font-weight: 300;
}

h2,
.mt-h2 {
    font-size: clamp(2rem, 3vw, 7rem);
    margin: 0 0 1rem 0;
}

.mt-p-lead {
	font-size: clamp(3rem, 6vw, 10rem);
    font-weight: 600;
    line-height: 1.2;
    margin: 1rem 0 1.5rem 0;
}

@media (--mq-medium) {
    .mt-p-lead {
        line-height: 1.2;
        margin: 0 0 3rem 0;
    }
}

.mt-p-sub {
    font-size: clamp(2rem, 1.5vw, 7rem);
    font-weight: 300;
    line-height: 1.4;
    margin: 0 0 2.5vh 0;
}

.mt-work-logo {
    margin: 3rem 0 0 0;
}

.mt-blog-post {
    margin: 0 0 2.5vh 0;
}

p {
    font-weight: 300;
    line-height: 1.4;
    margin: 0 0 2.5vh 0;
}

a {
    color: var(--color-black);
    text-decoration: underline;
}

a:hover {
    color: var(--color-black);
    text-decoration: none;
}

/* Case studies: list on the homepage */

.mt-case-link {
    margin: 0 0 2.5vh 0;
}

.mt-case-link__title {
    font-size: 1.15em;
}

.mt-case-link__meta {
    color: var(--color-text-alt);
    font-size: 0.8em;
    margin: 0.25rem 0 0 0;
}

/* Case studies: page */

.mt-case-hero-image {
    display: block;
    width: 30%;
    margin: 1rem 0 2rem 0;
}

@media (--mq-large) {
    .mt-case-hero-image {
        width: 80%;
        max-width: none;
        margin: 0;
        margin: 3rem 0 2rem 2rem;
    }
}

.mt-case-kicker {
    font-size: 0.8em;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 1rem 0.25rem;
}

.mt-case-title {
    font-size: clamp(2.25rem, 5vw, 6rem);
    font-weight: 600;
    line-height: 1.15;
    margin: 0 0 1.5rem 0;
}

.mt-case-standfirst {
    font-size: clamp(1.25rem, 2vw, 2rem);
    font-weight: 300;
    line-height: 1.4;
    margin: 0;
    max-width: 900px;
}

.mt-case-meta {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin: 2.5rem 0 0 0;
    padding: 1.5rem 0;
    border-top: 1px solid var(--color-grey-mid-light);
    border-bottom: 1px solid var(--color-grey-mid-light);
}

@media (--mq-medium) {
    .mt-case-meta {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1.5rem 2rem;
    }
}

.mt-case-meta__key {
    color: var(--color-text-alt);
    font-size: 0.75em;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 0.25rem 0;
}

.mt-case-meta__value {
    font-weight: 300;
    line-height: 1.4;
    margin: 0;
}

/* Case studies: body copy. Plain HTML, so style the elements directly. */

.mt-case-body {
    max-width: 800px;
}

.mt-case-body h3 {
    font-size: clamp(1.15rem, 1.6vw, 1.5rem);
    font-weight: 600;
    margin: 2.5rem 0 0.5rem 0;
}

.mt-case-body ul,
.mt-case-body ol {
    font-weight: 300;
    line-height: 1.4;
    margin: 0 0 2.5vh 0;
    padding-left: 1.2rem;
}

.mt-case-body li {
    margin: 0 0 0.75rem 0;
}

.mt-quote {
    border-left: 3px solid var(--color-grey-mid);
    margin: 3rem 0;
    padding: 0 0 0 1.5rem;
}

.mt-quote p {
    font-size: clamp(1.15rem, 1.8vw, 1.6rem);
    font-weight: 300;
    line-height: 1.4;
    margin: 0 0 0.75rem 0;
}

.mt-quote__source {
    color: var(--color-text-alt);
    font-size: 0.8em;
    font-style: normal;
}

.mt-figure {
    margin: 3rem 0;
}

.mt-figure img,
.mt-figure video {
    display: block;
    width: 100%;
    height: auto;
    background-color: var(--color-white);
    border: 1px solid var(--color-grey-mid-light);
}

/* For a row of images of different shapes: crop them to a common ratio so the
   row lines up and the captions sit level. */
.mt-figure--crop img {
    aspect-ratio: 3 / 4;
    object-fit: cover;
}

.mt-figure__caption {
    color: var(--color-text-alt);
    font-size: 0.8em;
    line-height: 1.4;
    margin: 0.75rem 0 0 0;
}

.mt-case-nav {
    border-top: 1px solid var(--color-grey-mid-light);
    padding: 2rem 0 0 0;
}

.mt-case-nav__key {
    color: var(--color-text-alt);
    font-size: 0.75em;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 0.25rem 0;
}

.mt-case-nav__next {
    font-size: clamp(1.25rem, 2.5vw, 2rem);
    font-weight: 600;
    margin: 0 0 2rem 0;
}

.mt-case-nav__back {
    margin: 0;
}

/* Only for the placeholder images in the draft case studies. Delete the class
   from the markup once a real image is in, so the figure runs full width. */
.mt-figure--placeholder img {
    max-width: 420px;
}

/* Open to work banner */

.mt-banner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    border: 1px solid var(--color-grey-mid);
    padding: 1.5rem;
    margin: 3rem 0;
}

@media (--mq-medium) {
    .mt-banner {
        flex-direction: row;
        align-items: center;
    }
}

.mt-banner__image {
    display: block;
    width: 120px;
    height: auto;
    margin: 0 0 1rem 0;
}

@media (--mq-medium) {
    .mt-banner__image {
        flex: none;
        margin: 0 1.5rem 0 0;
    }
}

.mt-banner__title {
    font-weight: 600;
}

.mt-banner p:last-child {
    margin-bottom: 0;
}

.mt-footer {
    padding: 1rem .5rem 0rem .5rem;
}

.mt-footer__colophon {
    margin: 0;
    text-align: left;
}

@media (--mq-medium) {

    .mt-footer__end p {
        margin: 0;
        text-align: right;
    }
}
